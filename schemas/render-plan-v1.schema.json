{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/narrated-video/render-plan-v1.schema.json",
  "title": "Derived RenderPlan v1",
  "description": "An ephemeral, renderer-neutral execution plan compiled from NarratedProject and realized media durations.",
  "type": "object",
  "required": ["kind", "version", "source_project", "stage", "fps", "width", "height", "total_frames", "motion", "shots", "captions", "subtitles", "audio", "music"],
  "properties": {
    "kind": {"const": "RenderPlan"},
    "version": {"const": 1},
    "source_project": {
      "type": "object",
      "required": ["kind", "version", "id"],
      "properties": {
        "kind": {"const": "NarratedProject"},
        "version": {"const": 1},
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
      },
      "additionalProperties": false
    },
    "stage": {"enum": ["demo", "full"]},
    "fps": {"type": "integer", "minimum": 1, "maximum": 60},
    "width": {"type": "integer", "minimum": 64, "multipleOf": 2},
    "height": {"type": "integer", "minimum": 64, "multipleOf": 2},
    "total_frames": {"type": "integer", "minimum": 1},
    "motion": {"type": "object"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start_frame", "duration_frames", "spoken_frames", "transition_frames", "incoming_transition_frames", "type", "asset", "source_start", "loop", "motion", "layers", "graphics", "effects"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "start_frame": {"type": "integer", "minimum": 0},
          "duration_frames": {"type": "integer", "minimum": 1},
          "spoken_frames": {"type": "integer", "minimum": 1},
          "transition_frames": {"type": "integer", "minimum": 0},
          "incoming_transition_frames": {"type": "integer", "minimum": 0},
          "type": {"enum": ["image", "video"]},
          "asset": {"type": "string", "minLength": 1},
          "source_start": {"type": "number", "minimum": 0},
          "source_duration": {"type": "number", "exclusiveMinimum": 0},
          "loop": {"type": "boolean"},
          "motion": {"enum": ["still", "push", "pull", "pan-left", "pan-right"]},
          "layers": {"type": "array", "items": {"type": "object"}},
          "graphics": {"type": "array", "items": {"type": "object"}},
          "effects": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "captions": {"type": "array", "items": {"type": "object"}},
    "subtitles": {"type": "object"},
    "audio": {"type": "object", "additionalProperties": {"type": "object"}},
    "music": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
