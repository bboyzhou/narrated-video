{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/narrated-video/project.schema.json",
  "title": "narrated-video project generated-video extension",
  "type": "object",
  "required": ["version", "storyboard", "shots"],
  "properties": {
    "version": {"const": 1},
    "storyboard": {"type": "string", "minLength": 1},
    "video_generation": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string", "minLength": 1},
        "profile": {"enum": ["smoke", "fast", "balanced", "quality", "max_quality"]},
        "runtime": {
          "oneOf": [
            {"enum": ["auto", "local", "kaggle", "colab", "runpod", "remote_worker", "cloud_api"]},
            {"type": "object", "required": ["type"], "properties": {
              "type": {"enum": ["auto", "local", "kaggle", "colab", "runpod", "remote_worker", "cloud_api"]},
              "hardware": {"type": "object"},
              "overrides": {"type": "object", "properties": {"max_vram_gib": {"type": "number", "exclusiveMinimum": 0}, "device": {"type": "string"}}, "additionalProperties": false}
            }, "additionalProperties": false}
          ]
        },
        "policy": {"enum": ["none", "highlights", "selected", "all"]},
        "max_scenes": {"type": "integer", "minimum": 1},
        "i2v_budget": {"type": "object", "properties": {
          "enabled": {"type": "boolean"}, "max_shots": {"type": "integer", "minimum": 1},
          "max_generated_seconds_per_shot": {"type": "number", "exclusiveMinimum": 0}
        }, "additionalProperties": false},
        "providers": {"type": "object", "additionalProperties": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "asset"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "type": {"enum": ["image", "video"]},
          "asset": {"type": "string", "minLength": 1},
          "generated_video": {
            "type": "object",
            "required": ["provider", "cache_key", "asset", "sha256"],
            "properties": {
              "provider": {"type": "string"},
              "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "asset": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
